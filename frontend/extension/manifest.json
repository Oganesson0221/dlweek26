{
  "manifest_version": 3,
  "name": "Microsoft CoursePilot - Clippy Notes",
  "version": "1.0.0",
  "description": "Save notes from any webpage with Clippy! Your friendly Microsoft CoursePilot study companion.",
  "permissions": ["storage", "activeTab", "contextMenus", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/clippy-16.png",
      "32": "icons/clippy-32.png",
      "48": "icons/clippy-48.png",
      "128": "icons/clippy-128.png"
    },
    "default_title": "Clippy Notes"
  },
  "icons": {
    "16": "icons/clippy-16.png",
    "32": "icons/clippy-32.png",
    "48": "icons/clippy-48.png",
    "128": "icons/clippy-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content-styles.css"]
    }
  ]
}
